# ============================================================
# FINRESOLVE Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- Server ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- MongoDB ---
# Leave empty to use MongoMemoryServer (automatic in-memory fallback)
MONGODB_URI=
MONGODB_DB_NAME=finresolve

# --- Google Gemini AI (Optional) ---
# Leave empty to use deterministic investigation mode (no AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Docker MongoDB Auth ---
MONGO_PASSWORD=finresolve_secure_2026
