# MongoDB
MONGODB_URI=mongodb://localhost:27017/finresolve
MONGODB_DB_NAME=finresolve

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Policy Thresholds (Overrides default finance rules)
# CONFIDENCE_THRESHOLD=0.85
# EVIDENCE_COMPLETENESS_THRESHOLD=0.80
# MAX_AUTO_RESOLVE_AMOUNT=10000
